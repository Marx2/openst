REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional: enables the Postgres-backed bond routes (D79). Without it openst
# still starts and serves the non-bond endpoints. Migrations run at boot.
DATABASE_URL=postgresql://openst:openst@localhost:5432/openst
FMP_API_KEY=your_fmp_api_key_here
INTRINIO_API_KEY=your_intrinio_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here
NASDAQ_API_KEY=your_nasdaq_api_key_here
